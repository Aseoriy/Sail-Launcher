{
    "id": "aseoriy.rail-layout",
    "name": "Rail",
    "version": "1.0.0",
    "author": "Aseoriy",
    "description": "A slim icon rail on the left, big rounded covers, a recently played row and a tall hero game page, in deep navy with a colour of your choice.",
    "type": "layout",
    "requires": {
        "aseoriy.library-layouts": {
            "version": "^2.0.0",
            "hub": "b2ac4147-faca-4770-87d2-b429a8fa5abf"
        }
    },
    "settings": [
        {
            "type": "heading",
            "label": "Look"
        },
        {
            "id": "accent",
            "type": "select",
            "label": "Accent colour",
            "default": "violet",
            "options": [
                {
                    "value": "violet",
                    "label": "Violet"
                },
                {
                    "value": "teal",
                    "label": "Teal"
                },
                {
                    "value": "amber",
                    "label": "Amber"
                }
            ]
        },
        {
            "id": "labels",
            "type": "toggle",
            "label": "Names next to the icons",
            "description": "A wider rail with each page's name, and your folders.",
            "default": false
        },
        {
            "type": "heading",
            "label": "Home page and panels"
        },
        {
            "id": "shelf",
            "type": "toggle",
            "label": "Recently played row",
            "default": true
        },
        {
            "id": "friends",
            "type": "toggle",
            "label": "Friends panel",
            "default": false
        }
    ],
    "layout": {
        "contract": 1,
        "styles": [
            "rail.css"
        ],
        "preview": "preview.png",
        "tokens": {
            "--sl-top": "#0b0d13",
            "--sl-bg": "#0f1117",
            "--sl-surface-strong": "#171a23",
            "--sl-menu-bg": "#1d2130",
            "--sl-menu-hover": "#272c3f",
            "--sl-menu-line": "#2a2f42",
            "--sl-menu-border": "#05060a",
            "--sl-text": "#c9cdda",
            "--sl-text-bright": "#e6e8ef",
            "--sl-muted": "#7d8499",
            "--sl-faint": "#5b6175",
            "--sl-art": "#141722",
            "--sl-letter": "#232838",
            "--sl-field": "#151823",
            "--sl-line": "rgba(255, 255, 255, .05)",
            "--sl-font": "\"Inter\", \"Segoe UI\", \"Noto Sans\", Arial, sans-serif"
        },
        "blocks": {
            "home": {
                "covers": "portrait",
                "shelf": {
                    "setting": "shelf",
                    "values": {
                        "true": "recent",
                        "false": "none"
                    }
                },
                "header": "none"
            },
            "gamePage": {
                "layout": "hero",
                "stats": [
                    "playtime",
                    "lastPlayed",
                    "achievements"
                ]
            },
            "manageGame": "properties",
            "friendsPanel": {
                "setting": "friends",
                "values": {
                    "true": "shown",
                    "false": "hidden"
                }
            }
        }
    }
}
